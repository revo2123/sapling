// Colour palette shared by all trees.

#let colors = (
  border: rgb("#1a2b4c"),
  fill: rgb("#f4f7f9"),
  // nodes the user passed in `marked`
  marked: rgb("#1f6fb2"),
  marked-fill: rgb("#d6e8f7"),
  // nodes that break the rules of their tree type (`show-errors`)
  error: rgb("#c0392b"),
  error-fill: rgb("#fdecea"),
)
